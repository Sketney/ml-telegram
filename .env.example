# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Канал: @username или числовой id вида -100xxxxxxxxxx. Бот должен быть админом с правом публикации.
CHANNEL_ID=
# Твой числовой Telegram user id (@userinfobot). Бот слушает только его.
ADMIN_ID=

# --- LLM ---
# anthropic | openai | fake  (fake — без ключа, отдаёт заготовки: проверить бота до покупки API)
LLM_PROVIDER=fake
LLM_API_KEY=
# Модель для текстов. Для anthropic по умолчанию claude-sonnet-5-5; для openai укажи явно.
LLM_MODEL=
# Дешёвая модель для отбора тем (понадобится на этапе 2). Для anthropic по умолчанию claude-haiku-5-5.
LLM_MODEL_CHEAP=

# --- База ---
# Только латинские буквы и цифры: пароль подставляется в адрес базы как есть.
POSTGRES_PASSWORD=change-me
# В docker-compose собирается автоматически из POSTGRES_PASSWORD. Меняй, только если база внешняя.
# DATABASE_URL=postgresql+asyncpg://mlbot:change-me@db:5432/mlbot

# --- Оформление ---
TIMEZONE=Asia/Tbilisi
# Фирменный эмодзи-маркер разделов ({E} в шаблонах)
BRAND_EMOJI=🧠
# Девиз рядом с названием канала на обложках постов. Пусто — без девиза.
CHANNEL_TAGLINE=
# Подпись в конце поста, например: <a href="https://t.me/your_channel">Название канала</a>. Пусто — без подписи.
CHANNEL_SIGNATURE=
# Пятый вариант «Посмотреть ответ» в квизах
QUIZ_SHOW_ANSWER_OPTION=true

# --- Обложки постов ---
# Короткий пост выходит как фото с подписью, и адрес ему не нужен. Длинному посту картинку подтягивает
# сам Telegram по её адресу, поэтому обложки нужно раздавать наружу. Для этого:
#   COMPOSE_PROFILES=web — поднять веб-сервер (порты 80 и 443 должны быть открыты);
#   MEDIA_HOST — имя, на которое он получит сертификат. Домена нет — подойдёт <IP через дефисы>.sslip.io;
#   MEDIA_BASE_URL — тот же адрес с /m на конце.
# Не заполнено — длинные посты выходят без обложки.
# COMPOSE_PROFILES=web
# MEDIA_HOST=203-0-113-10.sslip.io
# MEDIA_BASE_URL=https://203-0-113-10.sslip.io/m

# --- Голосовые ---
# Модель faster-whisper для расшифровки: tiny, base, small (по умолчанию), medium. Пусто — выключить.
# small занимает около 1 ГБ памяти на время расшифровки; medium точнее, но ему нужно 2–3 ГБ.
# WHISPER_MODEL=small
